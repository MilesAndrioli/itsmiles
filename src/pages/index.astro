---
import Skeleton from "@/layouts/Skeleton.astro";
// import ProceduralVoid from "@/components/ProceduralVoid.astro";
import ProgressButton from "@/components/ProgressButton.astro";
import AsciiVideo from "@/components/AsciiVideo.astro";
import { contact } from "@/data/contact";
---

<Skeleton
    title="Home"
    description="Hey, it's Miles Andrioli, and this is my portfolio."
    class="grid"
>
    <!-- <ProceduralVoid preset="obsidian-gold-reveal" /> -->

    <section class="heroF">
        <div class="contained">
            <div
                data-aos-group="split-up-blur"
                data-aos-duration="1200"
                data-aos-stagger-gap="220"
                data-aos-delay="100"
            >
                <div class="grid gap-10 lg:grid-cols-12 lg:gap-20">
                    <h1
                        class="text-iron-300 col-span-full m-0 font-serif text-6xl lg:text-8xl"
                        data-aos-child="split-left-blur"
                    >
                        Hey, it's Miles.
                    </h1>

                    <div
                        class="order-first lg:order-0 lg:col-span-4 lg:col-start-3 lg:h-0"
                        data-aos-child="fade-in-blur-out"
                    >
                        <AsciiVideo
                            src="/Choom.mp4"
                            class="overflow-hidden rounded-4xl"
                            mediaClass="aspect-4/5 w-full object-cover object-center"
                            data-ascii-width="80"
                            data-ascii-color="#cc2828"
                            data-ascii-charset="blocks"
                            data-ascii-contrast="30"
                            data-ascii-lh="1"
                        />
                    </div>

                    <div class="col-span-full lg:col-start-7">
                        <h2 class="text-iron-400 text-xl" data-aos-child>
                            Focused on fluid and highly interactive web
                            experiences. Currently exploring 3D on the web with
                            WebGL, GLSL, Three.js, and Theatre.js.
                        </h2>
                        <p class="text-lg" data-aos-child>
                            This is still a work in progress. In the meantime,
                            check out my
                            <a
                                href="/resume/"
                                class="swipe-link text-red-500"
                                data-hover-shuffle
                            >
                                resume
                            </a>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

