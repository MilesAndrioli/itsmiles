---
import Skeleton from "@/layouts/Skeleton.astro";
import ProceduralVoid from "@/components/ProceduralVoid.astro";
import ProgressButton from "@/components/ProgressButton.astro";
import ParallaxImage from "@/components/ParallaxImage.astro";
import { contact } from "@/data/contact";
// import image_1 from "@/assets/images/Knight in Shadows.webp";
import image_2 from "@/assets/images/Purgatum_8.png";
---

<Skeleton
    title="Home"
    description="Hey, it's Miles Andrioli, and this is my portfolio."
    class="grid py-40"
>
    <ProceduralVoid preset="obsidian-gold-reveal" />
    <section class="hero-fixed -mt-40">
        <div class="container">
            <div data-aos-group="split-up-chromatic" data-aos-delay="100">
                <div data-aos="fade-in" data-aos-after data-aos-scrub>
                    <div class="grid place-content-center gap-3">
                        <h1
                            class="text-iron-300 mb-0 font-serif text-8xl"
                            data-aos-child
                        >
                            Hey, it's Miles!
                        </h1>
                        <h2 class="mb-0 text-xl" data-aos-child>
                            This is still a work in progress. In the meantime,
                            check out my <a
                                href="/resume/"
                                class="swipe-link text-jade"
                                data-hover-shuffle>resume</a
                            >.
                        </h2>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- DOUBLE CHECK THIS SECTION -->
    <section>
        <div class="container">
            <div
                data-aos-group="fade-in"
                data-aos-duration="1200"
                data-aos-stagger-gap="220"
            >
                <div data-aos="fade-in" data-aos-after data-aos-scrub>
                    <div class="grid gap-20 md:grid-cols-2">
                        <div class="overflow-hidden rounded-xl" data-aos-child>
                            <ParallaxImage
                                src={image_2}
                                alt=""
                                intensity={130}
                                class="filter-[grayscale(1)_contrast(140%)]"
                            />
                        </div>

                        <div>
                            <div class="sticky--below-center sticky grid gap-6">
                                <p
                                    class="text-iron-200 mb-0 font-serif text-5xl"
                                    data-aos-child="split-up-chromatic"
                                >
                                    Hey, it's Miles!
                                </p>

                                <h1
                                    class="mb-0 text-2xl"
                                    data-aos-child="split-up-chromatic"
                                >
                                    Front-end Developer with 7 years of
                                    experience based in Málaga, Spain.
                                </h1>

                                <p
                                    class="mb-0"
                                    data-aos-child="split-up-chromatic"
                                >
                                    Bilingual in Spanish and English. <a
                                        href={contact.linkedin}
                                        target="_blank"
                                        class="text-jade swipe-link">Open</a
                                    > to remote or on-site roles worldwide.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="min-h-dvh place-content-center overflow-hidden">
        <div class="container">
            <p
                class="font-display text-iron-400 mb-0 text-justify text-6xl tracking-wider uppercase"
                data-aos="split-left-chromatic"
                data-aos-scrub
                data-aos-split-gap="400"
                data-aos-duration="4000"
            >
                Focused on fluid and highly interactive web experiences.
            </p>
        </div>
    </section>

    <ProgressButton
        text="Let's connect!"
        aria-label="Let's connect!"
        icon="🔗"
        href={contact.linkedin}
        target="_blank"
        rel="noopener noreferrer"
    />
</Skeleton>
