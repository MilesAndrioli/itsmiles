---
import Skeleton from "../layouts/Skeleton.astro";

import Home_1 from "../sections/Home_1.astro";

import CloneLink from "../components/CloneLink.astro";

import { Picture } from "astro:assets";
import Image_1 from "../assets/images/Knight in Shadows.webp";
import Image_2 from "../assets/images/Dark Knight Serenity.webp";
import Image_3 from "../assets/images/Ethereal Ice Knight.webp";
import Image_4 from "../assets/images/Shadowed Knight Encounter.webp";
---

<Skeleton title="Home" description="This will be the Home page description.">
    <section
        class="hero"
        data-aos-group="fade-in"
        data-aos-delay="200"
        data-aos-duration="900"
        data-aos-stagger-gap="440"
        data-aos-name="heroSection"
    >
        <div
            class="container grid grid-cols-2 gap-20"
            data-aos="fade-in"
            data-aos-after
            data-aos-scrub
        >
            <div
                class="border-void-200 -scale-x-100 overflow-hidden rounded-2xl border"
            >
                <Picture
                    src={Image_1}
                    alt=""
                    formats={["avif", "webp"]}
                    height={1440}
                    class="h-12/10 w-full object-cover"
                    data-speed="auto"
                    pictureAttributes={{
                        class: "h-full block overflow-hidden",
                        "data-aos-child": "elder-scroll",
                    }}
                />
            </div>

            <div>
                <button data-aos-trigger="heroSection" class="swipe-link">
                    DEBUG:
                </button>

                <div class="sticky--below-center sticky grid gap-6">
                    <p
                        class="font-iskry mb-0 text-6xl text-stone-300"
                        data-aos-child="split-chromatic-up"
                        data-aos-split="chars"
                    >
                        Hey, it's Miles!
                    </p>

                    <h1
                        class="mb-0 text-4xl"
                        data-aos-child="split-chromatic-up"
                        data-aos-split="lines"
                    >
                        Creative Front-end Developer crafting seamless
                        experiences for the web with care, precision, and
                        curiosity.
                    </h1>

                    <p
                        class="text-xl"
                        data-aos-child="split-chromatic-up"
                        data-aos-split="words"
                    >
                        Based in Spain &mdash;
                        <CloneLink
                            text="open"
                            href="https://www.linkedin.com/in/MilesAndrioliBachini/"
                            target="_blank"
                        /> to remote or on-site opportunities worldwide.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section>
        <div class="container" data-aos="fade-in" data-aos-after data-aos-scrub>
            <p
                class="font-monument text-justify text-6xl uppercase"
                data-aos="split-chromatic-up"
                data-aos-split="words"
                data-aos-scrub
                data-aos-split-gap="300"
                data-aos-duration="2000"
                data-aos-end="top 25%"
            >
                Lorem ipsum dolor sit amet consectetur adipisicing elit.
                Cupiditate error voluptatem ducimus placeat sint perspiciatis
                consequatur id, reprehenderit eius dolor repudiandae quos autem,
                praesentium deleniti ab explicabo tempora quod obcaecati.
            </p>
        </div>
    </section>

    <section
        data-aos-group="fade-in"
        data-aos-delay="200"
        data-aos-duration="1200"
        data-aos-stagger-gap="460"
        data-aos-name="heroSection2"
    >
        <div
            class="container grid grid-cols-2 gap-20"
            data-aos="fade-in"
            data-aos-after
            data-aos-scrub
        >
            <div
                class="border-void-100 -scale-x-100 overflow-hidden rounded-2xl border"
            >
                <Picture
                    src={Image_2}
                    alt=""
                    formats={["avif", "webp"]}
                    height={1440}
                    class="h-11/10 w-full object-cover"
                    data-speed="auto"
                    pictureAttributes={{
                        class: "h-full block overflow-hidden",
                        "data-aos-child": "elder-scroll",
                    }}
                />
            </div>

            <div>
                <div class="sticky--above-center sticky">
                    <h1
                        class="font-monument text-3xl text-stone-300 uppercase"
                        data-aos-child="split-chromatic-up"
                        data-aos-split="words"
                    >
                        Hey, <mark>it's Miles</mark>! Front-end Developer based
                        in Málaga, Spain, with over 7 years of experience.
                    </h1>

                    <p
                        class="text-xl"
                        data-aos-child="split-chromatic-up"
                        data-aos-split="words"
                    >
                        Eager to keep learning and pushing myself.
                        <br />
                        <CloneLink
                            text="Open"
                            href="https://www.linkedin.com/in/MilesAndrioliBachini/"
                            target="_blank"
                        /> to remote or on-site opportunities.
                    </p>

                    <button
                        data-aos-child
                        data-aos-trigger="heroSection2"
                        class="swipe-link"
                    >
                        DEBUG:
                    </button>
                </div>
            </div>
        </div>
    </section>

    <Home_1 />

