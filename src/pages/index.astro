---
import Skeleton from "@/layouts/Skeleton.astro";
import ProceduralVoid from "@/components/ProceduralVoid.astro";
import ProgressButton from "@/components/ProgressButton.astro";
import { contact } from "@/data/contact";
---

<Skeleton
    title="Home"
    description="Hey, it's Miles Andrioli, and this is my portfolio."
    class="grid py-40"
>
    <ProceduralVoid preset="obsidian-gold-reveal" />

    <section class="-mt-40 min-h-dvh content-center">
        <div class="contained">
            <div
                data-aos-group="split-left-blur"
                data-aos-duration="1200"
                data-aos-stagger-gap="280"
                data-aos-delay="100"
            >
                <div data-aos="fade-in" data-aos-after data-aos-scrub>
                    <div class="grid gap-20 lg:grid-cols-12">
                        <h1
                            class="text-iron-300 col-span-full m-0 font-serif text-7xl lg:order-last"
                            data-aos-child
                        >
                            Hey, it's Miles.
                        </h1>

                        <div class="col-span-full lg:col-start-7">
                            <h2 class="text-iron-400 text-xl" data-aos-child>
                                Focused on fluid and highly interactive web
                                experiences. Currently exploring 3D on the web
                                with WebGL, GLSL, Three.js, and Theatre.js.
                            </h2>
                            <p class="text-lg" data-aos-child>
                                This is still a work in progress. In the
                                meantime, check out my
                                <a
                                    href="/resume/"
                                    class="swipe-link text-jade"
                                    data-hover-shuffle
                                >
                                    resume
                                </a>.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="min-h-dvh place-content-center overflow-hidden">
        <div class="contained">
            <p
                class="font-display text-iron-400 mb-0 text-justify text-7xl tracking-wider uppercase"
                data-aos="split-left-chromatic"
                data-aos-scrub
                data-aos-split-gap="400"
                data-aos-duration="4000"
            >
                Focused on fluid and highly interactive web experiences.
                Currently exploring 3D on the web with WebGL, GLSL, Three.js,
                and Theatre.js.
            </p>
        </div>
    </section>

    <ProgressButton
        text="Let's connect!"
        aria-label="Let's connect!"
        icon="🔗"
        href={contact.linkedin}
        target="_blank"
        rel="noopener noreferrer"
    />
</Skeleton>
