---
import resume from "@/data/resume.yaml";
import { contact } from "@/data/contact";

import Skeleton from "@/layouts/Skeleton.astro";

import ResumeSidebar from "@/sections/ResumeSidebar.astro";
import ResumeMain from "@/sections/ResumeMain.astro";
import Divider from "@/components/Divider.astro";

const { meta, experience, skills, projects } = resume;
---

<Skeleton
    title="Resume"
    description="Miles Andrioli Bachini — Creative Front-end Developer"
    emoji="📄"
    class="ResumePage py-14"
    header={false}
    footer={false}
>
    <div
        data-aos-group="fade-in-blur-out"
        data-aos-stagger-gap="100"
        data-aos-duration="1200"
    >
        <div class="container max-w-5xl">
            <Divider />
            <div class="flex">
                <Divider vertical />
                <div
                    class="ResumeGrid bg-iron-950 z-75 grid flex-1 gap-5 rounded-xl md:grid-cols-[1fr_auto_2fr] md:gap-0"
                >
                    <ResumeSidebar
                        name={meta.name}
                        title={meta.title}
                        contact={contact}
                        skills={skills}
                    />
                    <Divider vertical class="hidden md:block" />
                    <ResumeMain
                        name={meta.name}
                        title={meta.title}
                        experience={experience}
                        projects={projects}
                    />
                </div>
                <Divider vertical />
            </div>
            <Divider />
        </div>
    </div>
</Skeleton>
