---
import resume from "@/data/resume.yaml";
import { contact } from "@/data/contact";

import Skeleton from "@/layouts/Skeleton.astro";

import ResumeSidebar from "@/sections/ResumeSidebar.astro";
import ResumeMain from "@/sections/ResumeMain.astro";
import Divider from "@/components/Divider.astro";
import ProgressButton from "@/components/ProgressButton.astro";

import ProceduralVoid from "@/components/ProceduralVoid.astro";

const { meta, experience, skills, projects } = resume;
---

<Skeleton
    title="Resume"
    description="Miles Andrioli Bachini — Creative Front-end Developer"
    class="ResumePage min-h-dvh place-content-center py-16 print:min-h-auto print:py-0"
>
    <ProceduralVoid preset="obsidian-gold-reveal" />

    <div data-aos-group="fade-in-left-blur-out" data-aos-stagger-gap="40">
        <div class="contained max-w-5xl print:max-w-none print:p-0">
            <Divider class="hidden md:block" />
            <div class="flex">
                <Divider vertical class="hidden md:block" />
                <div
                    class="ResumeGrid md:bg-iron-950 z-65 grid flex-1 gap-5 md:grid-cols-[1fr_auto_2fr] md:gap-0 md:rounded-xl print:grid-cols-[1fr_auto_2fr] print:gap-0"
                >
                    <ResumeSidebar
                        name={meta.name}
                        title={meta.title}
                        contact={contact}
                        skills={skills}
                    />
                    <Divider
                        vertical
                        class="hidden md:block print:block"
                        data-aos-child="fade-in-blur-out"
                    />
                    <ResumeMain
                        name={meta.name}
                        title={meta.title}
                        experience={experience}
                        projects={projects}
                    />
                </div>
                <Divider vertical class="hidden md:block" />
            </div>
            <Divider class="hidden md:block" />
        </div>
    </div>

    <ProgressButton
        text="Print Resume"
        aria-label="Print Resume"
        icon="📄"
        onclick="const t = document.title; document.title = 'Miles-Andrioli_Resume'; window.print(); document.title = t;"
    />
</Skeleton>
