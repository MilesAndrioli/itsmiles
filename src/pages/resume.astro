---
import resume from "@/data/resume.yaml";
import { contact } from "@/data/contact";

import Skeleton from "@/layouts/Skeleton.astro";

import ResumeSidebar from "@/sections/ResumeSidebar.astro";
import ResumeMain from "@/sections/ResumeMain.astro";
import Divider from "@/components/Divider.astro";
import ScrollProgressButton from "@/components/ScrollProgressButton.astro";

const { meta, experience, skills, projects } = resume;
---

<Skeleton
    title="Resume"
    description="Miles Andrioli Bachini — Creative Front-end Developer"
    emoji="📄"
    class="ResumePage min-h-dvh place-content-center py-16 print:min-h-auto print:py-0"
    header={false}
>
    <div
        data-aos-group="fade-in-blur-out"
        data-aos-stagger-gap="100"
        data-aos-duration="1200"
    >
        <div class="container max-w-4xl print:max-w-none print:p-0">
            <Divider class="hidden md:block" />
            <div class="flex">
                <Divider vertical class="hidden md:block" />
                <div
                    class="ResumeGrid md:bg-iron-950/80 z-55 grid flex-1 gap-5 md:grid-cols-[1fr_auto_2fr] md:gap-0 md:rounded-xl md:backdrop-blur-lg md:backdrop-saturate-200 print:grid-cols-[1fr_auto_2fr]"
                >
                    <ResumeSidebar
                        name={meta.name}
                        title={meta.title}
                        contact={contact}
                        skills={skills}
                    />
                    <Divider vertical class="hidden md:block print:block" />
                    <ResumeMain
                        name={meta.name}
                        title={meta.title}
                        experience={experience}
                        projects={projects}
                    />
                </div>
                <Divider vertical class="hidden md:block" />
            </div>
            <Divider class="hidden md:block" />
        </div>
    </div>

    <ScrollProgressButton
        text="Print Resume"
        aria-label="Print Resume"
        icon="📄"
        onclick="window.print()"
    />
</Skeleton>
