---
import resume from "@/data/resume.yaml";
import { contact } from "@/data/contact";

import Skeleton from "@/layouts/Skeleton.astro";

import ResumeSidebar from "@/sections/ResumeSidebar.astro";
import ResumeMain from "@/sections/ResumeMain.astro";
import Divider from "@/components/Divider.astro";

const { meta, summary, experience, skills, projects, languages, setup } =
    resume;
---

<Skeleton
    title="Resume"
    description="Miles Andrioli Bachini — Creative Front-end Developer"
    emoji="📄"
    class="ResumePage py-14"
>
    <div
        data-aos-group="fade-in-blur-out"
        data-aos-stagger-gap="100"
        data-aos-duration="1200"
    >
        <div class="container max-w-5xl">
            <Divider />
            <div class="flex">
                <Divider vertical />
                <div class="ResumeGrid grid flex-1 md:grid-cols-[1fr_auto_2fr]">
                    <ResumeSidebar
                        name={meta.name}
                        title={meta.title}
                        contact={contact}
                        skills={skills}
                        languages={languages}
                        setup={setup}
                    />
                    <Divider vertical class="hidden md:block" />
                    <ResumeMain
                        name={meta.name}
                        title={meta.title}
                        summary={summary}
                        experience={experience}
                        projects={projects}
                    />
                </div>
                <Divider vertical />
            </div>
            <Divider />
        </div>
    </div>
</Skeleton>
