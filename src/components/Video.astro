---
const { src, height = "h-12/10" } = Astro.props;
---

<div class="border-ash-900 overflow-hidden rounded-xl border">
    <video
        src={src}
        muted
        autoplay
        playsinline
        loop
        class={`w-full ${height} object-cover`}
        data-speed="auto"></video>
</div>
