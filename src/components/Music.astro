<audio id="app-music" src="/dark-strings-and-choir-1.mp3" preload="auto" loop>
    Your browser does not support the audio element.
</audio>

<script>
    const audio = document.getElementById("app-music") as HTMLAudioElement;
    const cursor = (window as any).__CURSOR__;
    let isPlaying = false;

    cursor?.setText("Click to enable sound.");

    document.addEventListener(
        "mouseup",
        () => {
            if (isPlaying || !audio) return;

            audio.play().then(() => {
                isPlaying = true;
                cursor?.removeText();
            });
        },
        { once: true }
    );
</script>
