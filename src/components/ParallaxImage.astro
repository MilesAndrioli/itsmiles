---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    src: ImageMetadata;
    alt: string;
    width?: number;
    intensity?: string;
    class?: string;
}

const {
    src,
    alt,
    width = 2560,
    intensity = "12",
    class: className,
    ...rest
} = Astro.props;
---
