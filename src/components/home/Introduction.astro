---
import AsciiVideo from "@/components/AsciiVideo.astro";
---

<section class="hero">
    <div class="contained">
        <div
            data-aos-group="split-up-blur"
            data-aos-stagger-gap="180"
            data-aos-delay="450"
        >
            <div class="grid gap-10 md:grid-cols-12 md:gap-20">
                <h1
                    class="text-iron-300 col-span-full m-0 font-serif text-6xl md:text-7xl lg:text-8xl"
                    data-aos-child="split-left-blur"
                >
                    Hey, it's Miles.
                </h1>

                <div
                    class="order-first md:order-0 md:col-span-4 md:col-start-3 md:h-0"
                    data-aos-child="fade-up-blur"
                >
                    <AsciiVideo
                        src="/ChoomLoop.mp4"
                        class="overflow-hidden rounded-4xl"
                        mediaClass="aspect-4/5 w-full object-cover object-center"
                        data-ascii-charset="blocks"
                        data-ascii-contrast="50"
                    />
                </div>

                <div class="col-span-full md:col-start-7">
                    <h2
                        class="text-iron-400 text-xl"
                        data-aos-child
                        data-aos-will-change="transform"
                    >
                        Focused on fluid and interactive web experiences.
                        Currently exploring 3D on the web with WebGL, GLSL,
                        Three.js, and Theatre.js.
                    </h2>
                    <p
                        class="text-xl"
                        data-aos-child
                        data-aos-will-change="transform"
                    >
                        This is still a work in progress. In the meantime, check
                        out my
                        <a
                            href="/resume/"
                            class="swipe-link text-ruby"
                            data-hover-shuffle
                        >
                            resume
                        </a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
