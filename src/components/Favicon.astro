<link
    rel="icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 x=%22-.1em%22 font-size=%2290%22>😭</text></svg>"
/>
<script is:inline>
    (function () {
        var emojis = ["🍣", "🍕", "🍔", "🌭", "🌮", "🍜"];
        var pick = emojis[Math.floor(Math.random() * emojis.length)];
        var svg =
            "data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 x=%22-.1em%22 font-size=%2290%22>" +
            pick +
            "</text></svg>";
        document.querySelector('link[rel="icon"]').setAttribute("href", svg);
    })();
</script>
