---
interface Props {
    timezone?: string;
    willChange?: boolean;
    separator?: string;
    class?: string;
}

const { timezone = "Europe/Madrid", willChange = false, separator = ":", class: className } = Astro.props;
---

<div class:list={["TimezoneClock inline-flex items-center gap-2", className]} data-timezone={timezone}>
    <number-flow data-unit="hour" data-will-change={willChange || undefined} />
    <span class="TimezoneClock__Separator">{separator}</span>
    <number-flow data-unit="minute" data-will-change={willChange || undefined} />
    <span class="TimezoneClock__Separator">{separator}</span>
    <number-flow data-unit="second" data-will-change={willChange || undefined} />
</div>

<style>
    /* tabular-nums keeps digit widths consistent so the layout doesn't shift */
    .TimezoneClock { font-variant-numeric: tabular-nums; }
</style>

<script>
    import "number-flow";
    import { continuous } from "number-flow";

    const timing = {
        duration: 600,
        easing: "cubic-bezier(0.22, 0.61, 0.36, 1)",
    };

    function init() {
        document.querySelectorAll(".TimezoneClock").forEach((clock) => {
            const timezone = clock.dataset.timezone;

            // Build a unit -> element map so ticks skip querySelectorAll each second
            const unitMap = {};
            clock.querySelectorAll("number-flow").forEach((flow) => {
                unitMap[flow.dataset.unit] = flow;

                flow.format = { minimumIntegerDigits: 2, useGrouping: false };
                // continuous makes digits always roll upward (e.g. 59 -> 00 goes
                // forward, not backward through all digits)
                flow.plugins = [continuous];
                flow.transformTiming = timing;
                flow.spinTiming = timing;
                flow.opacityTiming = { duration: 300, easing: "ease-out" };
            });

            // Intl.DateTimeFormat is expensive to construct — create once per clock.
            // formatToParts returns each unit separately and handles DST automatically.
            const formatter = new Intl.DateTimeFormat("en-GB", {
                timeZone: timezone,
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit",
                hour12: false,
            });

            function tick() {
                for (const { type, value } of formatter.formatToParts(new Date())) {
                    if (type in unitMap) unitMap[type].update(Number(value));
                }
            }

            tick();
            setInterval(tick, 1000);
        });
    }

    window.addEventListener("load", init, { once: true });
</script>
