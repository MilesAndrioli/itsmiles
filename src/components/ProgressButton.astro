---
const { text, icon, href, class: className, ...attrs } = Astro.props;
const Tag = href ? "a" : "button";
const pathId = `ScrollProgressPath_${Math.random().toString(36).slice(2, 8)}`;

const radius = 75;
const charCount = text.length * 2 + 5; // "{text} · {text} ·"
const textLength = (2 * Math.PI * radius * (charCount - 1)) / charCount;
---

<Tag
    class:list={["ProgressButton", className]}
    {...href ? { href } : { type: "button" }}
    {...attrs}
>
    <div class="ProgressButton__Bar" aria-hidden="true">
        <span class="ProgressButton__Fill"></span>
        <span class="ProgressButton__Icon">{icon}</span>
    </div>
    <svg
        class="ProgressButton__Text"
        viewBox="0 0 200 200"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
    >
        <defs>
            <path
                id={pathId}
                d="M 100,100 m -75,0 a 75,75 0 1,1 150,0 a 75,75 0 1,1 -150,0"
            ></path>
        </defs>
        <text font-size="18">
            <textPath
                href={`#${pathId}`}
                textLength={textLength}
                lengthAdjust="spacing"
            >
                {text} · {text} ·
            </textPath>
        </text>
    </svg>
</Tag>

<style>
    @reference "@/styles/tailwind/tailwind.css";

    .ProgressButton {
        --size: 4.5rem;

        position: fixed;
        z-index: var(--floating-layer);
        bottom: var(--gappers);
        right: var(--gappers);

        width: var(--size);
        height: var(--size);
        padding: 0.375rem;

        cursor: pointer;
    }

    .ProgressButton__Bar {
        position: relative;
        height: 100%;
        overflow: hidden;

        display: grid;
        place-items: center;
        border-radius: 50%;

        @apply border-iron-800 border backdrop-blur-lg backdrop-saturate-200;
    }

    .ProgressButton__Fill {
        position: absolute;
        inset: 0;
        transform-origin: top;
        @apply bg-iron/20;
    }

    .ProgressButton__Text {
        position: absolute;
        inset: 50%;
        width: 140%;
        height: 140%;

        fill: currentColor;
        @apply font-display;
        text-transform: uppercase;

        translate: -50% -50%;
    }

    .ProgressButton {
        transition: scale var(--out--fast);

        .ProgressButton__Bar {
            transition: border-color var(--out--fast);
        }

        &:hover {
            scale: 95% !important;

            .ProgressButton__Bar {
                border-color: var(--color-iron-600);
            }
        }
    }
</style>
