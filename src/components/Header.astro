---
import Logo from "../components/Logo.astro";
import Divider from "../components/Divider.astro";
import CloneLink from "../components/CloneLink.astro";
import LiquidAss from "../components/LiquidAss.astro";
import { contact } from "../data/contact";
---

<header id="app-header">
    <LiquidAss class="bg-iron-950/50 py-3">
        <div class="container">
            <div class="flex items-center justify-between gap-3">
                <Logo />
                <nav>
                    <ul class="flex gap-3 font-mono text-xs">
                        <li>
                            <a
                                href={`mailto:${contact.email}`}
                                class="swipe-link"
                            >
                                {contact.email}
                            </a>
                        </li>
                        <li>
                            <a
                                href={contact.linkedin}
                                target="_blank"
                                class="swipe-link"
                            >
                                LinkedIn</a
                            >
                        </li>
                        <li>
                            <CloneLink href="/branding/" text="Branding" />
                        </li>
                        <li>
                            <CloneLink href="/resume/" text="Resume" />
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </LiquidAss>
    <Divider />
</header>
