---
import CloneLink from "@/components/CloneLink.astro";
import TimezoneClock from "@/components/TimezoneClock.astro";
// import { contact } from "@/data/contact";
---

<header id="app-header" class="py-3 mix-blend-difference">
    <div class="container">
        <div class="flex items-center justify-between gap-5">
            <TimezoneClock
                timezone="Europe/Madrid"
                willChange={true}
                separator="."
                class="text-iron-50 gap-1 font-mono text-sm"
            />
            <nav class="text-iron-50">
                <ul class="flex gap-3 text-sm">
                    <li>
                        <CloneLink href="/" text="Home" />
                    </li>
                    <li>
                        <CloneLink href="/resume/" text="Resume" />
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</header>
