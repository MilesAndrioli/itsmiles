---
import CloneLink from "@/components/CloneLink.astro";
import { contact } from "@/data/contact";
---

<header id="app-header" class="py-3 mix-blend-difference">
    <div class="container flex justify-end">
        <nav class="text-iron-50">
            <ul class="flex gap-3 text-xs">
                <li>
                    <CloneLink
                        href={`mailto:${contact.email}`}
                        text={`${contact.email}`}
                    />
                </li>
                <li>
                    <CloneLink
                        href={contact.linkedin}
                        target="_blank"
                        text="LinkedIn"
                    />
                </li>
                <li>
                    <CloneLink href="/branding/" text="Branding" />
                </li>
                <li>
                    <CloneLink href="/resume/" text="Resume" />
                </li>
            </ul>
        </nav>
    </div>
</header>
