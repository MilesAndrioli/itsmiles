---
import TimezoneClock from "@/components/TimezoneClock.astro";
---

<header id="app-header" class="pt-3 mix-blend-difference">
    <div class="contained">
        <div class="flex items-center justify-between gap-5">
            <TimezoneClock
                timezone="Europe/Madrid"
                willChange={true}
                separator="."
                class="text-iron-50 gap-1 font-mono text-sm"
            />
            <nav class="text-iron-50">
                <ul class="flex gap-3 text-sm">
                    <a href="/" class="swipe-link" data-hover-shuffle>Home</a>
                    <a href="/resume/" class="swipe-link" data-hover-shuffle
                        >Resume</a
                    >
                </ul>
            </nav>
        </div>
    </div>
</header>
