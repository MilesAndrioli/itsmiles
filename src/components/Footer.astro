---
import Divider from "@/components/Divider.astro";
import CloneLink from "@/components/CloneLink.astro";
import { contact } from "@/data/contact";

import LiquidAss from "@/components/LiquidAss.astro";
---

<footer id="app-footer">
    <Divider />
    <LiquidAss>
        <div data-reveal-wrapper class="py-20">
            <div data-reveal-target>
                <div class="container flex flex-col gap-10">
                    <div
                        class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between"
                    >
                        <div class="flex flex-col gap-2">
                            <CloneLink
                                href={`mailto:${contact.email}`}
                                text={contact.email}
                            />
                            <CloneLink
                                href={`tel:${contact.phone.replace(/\s/g, "")}`}
                                text={contact.phone}
                            />
                        </div>

                        <div class="flex flex-wrap gap-x-5 gap-y-2">
                            <CloneLink
                                href={contact.linkedin}
                                target="_blank"
                                text="LinkedIn"
                            />
                            <CloneLink
                                href={contact.github}
                                target="_blank"
                                text="GitHub"
                            />
                            <CloneLink
                                href={contact.codepen}
                                target="_blank"
                                text="CodePen"
                            />
                        </div>
                    </div>

                    <p class="text-iron-500 mb-0 max-w-lg font-mono text-xs">
                        Tempus leo eu aenean sed diam urna tempor. Pulvinar
                        vivamus fringilla lacus nec metus bibendum egestas.
                        Iaculis massa nisl malesuada lacinia integer nunc
                        posuere.
                    </p>

                    <div
                        class="flex flex-wrap items-center justify-between gap-4"
                    >
                        <p class="text-iron-500 font-mono text-xs">
                            &copy; {new Date().getFullYear()} Miles Andrioli
                        </p>
                        <p class="text-iron-500 font-mono text-xs">
                            Freehand Design, <strong>WIP</strong>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </LiquidAss>
</footer>
