---
import Divider from "@/components/Divider.astro";
import { contact } from "@/data/contact";
---

<footer id="app-footer" data-aos-group="fade-in-blur-out">
    <Divider />
    <div data-reveal-wrapper class="py-10">
        <div data-reveal-target>
            <div class="contained">
                <div
                    class="flex flex-wrap items-baseline justify-between gap-2"
                >
                    <span class="text-sm" data-aos-child>
                        &copy; {new Date().getFullYear()} Miles Andrioli &mdash; Freestyled
                        and coded from scratch.
                    </span>

                    <nav class="flex gap-2 text-sm">
                        <a
                            href="/"
                            class="swipe-link"
                            data-hover-shuffle
                            data-aos-child>Home</a
                        >
                        <a
                            href="/resume/"
                            class="swipe-link"
                            data-hover-shuffle
                            data-aos-child>Resume</a
                        >
                        <a
                            href={contact.linkedin}
                            target="_blank"
                            class="swipe-link"
                            data-hover-shuffle
                            data-aos-child>LinkedIn</a
                        >
                        <a
                            href={contact.github}
                            target="_blank"
                            class="swipe-link"
                            data-hover-shuffle
                            data-aos-child>GitHub</a
                        >
                        <a
                            href={contact.codepen}
                            target="_blank"
                            class="swipe-link"
                            data-hover-shuffle
                            data-aos-child>CodePen</a
                        >
                    </nav>
                </div>
            </div>
        </div>
    </div>
</footer>
