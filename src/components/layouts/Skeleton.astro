---
import "@/styles/app.css";

import Head from "@/components/Head.astro";
import Smoother from "@/components/Smoother.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Filter from "@/components/Filter.astro";
import Audio from "@/components/Audio.astro";
import Noise from "@/components/Noise.astro";
import Loader from "@/components/Loader.astro";
import Cursor from "@/components/Cursor.astro";

const { title, description, class: className } = Astro.props;
---

<!doctype html>
<html lang="en">
    <Head title={title} description={description} />
    <body class="antialiased" data-barba="wrapper">
        <Smoother>
            <Header />
            <div data-barba="container">
                <main id="app-main" class:list={[className]}>
                    <slot />
                </main>
                <Footer />
            </div>
        </Smoother>
        <Filter />
        <Noise />
        <Cursor />
        <Audio />
        <Loader />
        <script src="/src/scripts/app.js"></script>
    </body>
</html>
