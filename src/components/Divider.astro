---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"hr"> {
    fade?: "both" | "start" | "end";
    start?: string;
    end?: string;
    color?: string;
    vertical?: boolean;
}

const {
    fade = "both",
    start = "10%",
    end = "90%",
    color = "var(--color-iron)",
    vertical = false,
    class: className,
    ...rest
} = Astro.props;
---

<hr
    class:list={[
        "Divider",
        {
            Vertical: vertical,
            FadeStart: fade === "start",
            FadeEnd: fade === "end",
        },
        className,
    ]}
    {...rest}
/>

<style define:vars={{ start, end, color }}>
    .Divider {
        border: 0;
        height: 1px;
        background: linear-gradient(
            to right,
            transparent,
            var(--color) var(--start),
            var(--color) var(--end),
            transparent
        );
        mix-blend-mode: color-dodge;

        &.FadeEnd {
            background: linear-gradient(to right, var(--color) var(--end), transparent);
        }

        &.FadeStart {
            background: linear-gradient(to right, transparent, var(--color) var(--start));
        }

        &.Vertical {
            height: auto;
            width: 1px;
            align-self: stretch;
            background: linear-gradient(
                to bottom,
                transparent,
                var(--color) var(--start),
                var(--color) var(--end),
                transparent
            );

            &.FadeEnd {
                background: linear-gradient(
                    to bottom,
                    var(--color) var(--end),
                    transparent
                );
            }

            &.FadeStart {
                background: linear-gradient(
                    to bottom,
                    transparent,
                    var(--color) var(--start)
                );
            }
        }
    }
</style>
