---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"hr"> {
    fade?: "both" | "start" | "end";
    color?: string;
    vertical?: boolean;
}

const {
    fade = "both",
    color = "var(--color-iron)",
    vertical = false,
    class: className,
    ...rest
} = Astro.props;
---

<hr
    class:list={[
        "Divider",
        {
            Vertical: vertical,
            FadeStart: fade === "start",
            FadeEnd: fade === "end",
        },
        className,
    ]}
    {...rest}
/>

<style define:vars={{ color }}>
    .Divider {
        border: 0;
        height: 1px;
        background: linear-gradient(
            to right,
            transparent,
            var(--color) 15%,
            var(--color) 85%,
            transparent
        );
        mix-blend-mode: color-dodge;

        &.FadeEnd {
            background: linear-gradient(
                to right,
                var(--color) 85%,
                transparent
            );
        }

        &.FadeStart {
            background: linear-gradient(to left, var(--color) 85%, transparent);
        }

        &.Vertical {
            height: auto;
            width: 1px;
            align-self: stretch;
            background: linear-gradient(
                to bottom,
                transparent,
                var(--color) 15%,
                var(--color) 85%,
                transparent
            );

            &.FadeEnd {
                background: linear-gradient(
                    to bottom,
                    var(--color) 85%,
                    transparent
                );
            }

            &.FadeStart {
                background: linear-gradient(
                    to top,
                    var(--color) 85%,
                    transparent
                );
            }
        }
    }
</style>
