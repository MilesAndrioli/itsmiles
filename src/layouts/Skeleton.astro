---
import "../styles/app.css";

import Head from "../components/Head.astro";
import Smoother from "../components/Smoother.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Filter from "../components/Filter.astro";
import Noise from "../components/Noise.astro";
import Loader from "../components/Loader.astro";
import Cursor from "../components/Cursor.astro";

const {
    title,
    description,
    emoji,
    class: className,
    header = true,
    footer = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <Head title={title} description={description} emoji={emoji} />
    <body class="bg-iron-950 text-iron antialiased" data-barba="wrapper">
        <Smoother>
            {header && <Header />}
            <main id="app-main" class:list={[className]} data-barba="container">
                <slot />
            </main>
            {footer && <Footer />}
        </Smoother>
        <Filter />
        <Noise />
        <Cursor />
        <Loader />
        <script src="/src/scripts/app.js"></script>
    </body>
</html>
