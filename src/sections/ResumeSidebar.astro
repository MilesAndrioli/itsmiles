---
import CloneLink from "@/components/CloneLink.astro";
import Divider from "@/components/Divider.astro";
import ParallaxImage from "@/components/ParallaxImage.astro";
import userPhoto from "@/assets/images/Miles_0.jpeg";

const { name, title, summary, contact, skills, languages, setup } = Astro.props;
---

<aside class="ResumeSidebar grid content-start gap-5 p-8 pb-0 md:pb-8">
    <!-- Photo -->
    <div
        class="border-iron-800 hidden overflow-hidden rounded-xl border md:block"
        data-aos-child
    >
        <ParallaxImage
            src={userPhoto}
            alt={name}
            class="aspect-square filter-[grayscale(100%)_sepia(20%)_contrast(130%)_brightness(75%)]"
        />
    </div>

    <!-- Name, Title & Summary (mobile) -->
    <div class="grid gap-3 md:hidden" data-aos-child>
        <div class="grid gap-1">
            <h1 class="ResumeName text-iron-50 mb-0 font-serif text-4xl">
                {name}
            </h1>
            <h2 class="subtitle">
                {title}
            </h2>
        </div>
        <p class="text-iron-300">
            {summary}
        </p>
    </div>

    <Divider fade="end" class="md:hidden" data-aos-child="fade-in-blur-out" />

    <!-- Contact -->
    <div class="ResumeSection grid gap-1" data-aos-child>
        <h3 class="ResumeHeading subtitle mb-0 text-xs">Contact</h3>
        <ul class="text-iron-300 grid gap-1.5 text-sm">
            <li>
                <CloneLink
                    href={`mailto:${contact.email}`}
                    text={contact.email}
                />
            </li>
            <li>
                <CloneLink
                    href={`tel:${contact.phone.replace(/\s/g, "")}`}
                    text={contact.phone}
                />
            </li>
            <li>
                <CloneLink
                    href={contact.linkedin}
                    target="_blank"
                    text={contact.linkedin
                        .replace("https://www.", "")
                        .replace(/\/$/, "")}
                />
            </li>
        </ul>
    </div>

    <Divider fade="end" data-aos-child="fade-in-blur-out" />

    <!-- Skills -->
    <div class="ResumeSection grid gap-1" data-aos-child>
        <h3 class="ResumeHeading subtitle mb-0 text-xs">Skills</h3>
        <div class="grid gap-3">
            {
                skills.map((group) => (
                    <div class="grid">
                        <span class="text-iron-600 text-xs">
                            {group.category}
                        </span>
                        <span class="text-iron-300 text-sm">
                            {group.items.join(" · ")}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>

    <Divider fade="end" data-aos-child="fade-in-blur-out" />

    <!-- Languages -->
    <div class="ResumeSection grid gap-1" data-aos-child>
        <h3 class="ResumeHeading subtitle mb-0 text-xs">Languages</h3>
        <ul class="grid gap-1 text-sm">
            {
                languages.map((lang) => (
                    <li>
                        <span class="text-iron-300">{lang.name} · </span>
                        <span class="text-iron-600">{lang.level}</span>
                    </li>
                ))
            }
        </ul>
    </div>
</aside>
