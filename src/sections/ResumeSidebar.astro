---
import Divider from "@/components/Divider.astro";
import ParallaxImage from "@/components/ParallaxImage.astro";
import userPhoto from "@/assets/images/Miles_1.jpeg";

const { name, title, contact, skills } = Astro.props;
---

<aside class="ResumeSidebar grid content-start gap-5 md:p-8 print:p-8">
    <!-- Photo -->
    <a
        href={contact.linkedin}
        target="_blank"
        class="border-iron-800 overflow-hidden rounded-xl border print:border-transparent"
        data-aos-child
    >
        <ParallaxImage
            src={userPhoto}
            alt={name}
            class="aspect-square filter-[grayscale(100%)_sepia(20%)_contrast(130%)_brightness(75%)] print:filter-[grayscale(100%)]"
        />
    </a>

    <!-- Name & Title (mobile) -->
    <div class="grid gap-1 md:hidden print:hidden" data-aos-child>
        <h1 class="ResumeName text-iron-50 mb-0 font-serif text-4xl">
            {name}
        </h1>
        <h2 class="subtitle">
            {title}
        </h2>
    </div>

    <!-- Summary -->
    <div class="ResumeSection grid gap-1" data-aos-child>
        <h3 class="ResumeHeading subtitle mb-0 text-xs">About</h3>
        <div>
            <p class="text-iron-400 print:text-iron-800 text-sm">
                Front-end developer with 7 years of experience based in Málaga,
                Spain.
            </p>
            <p
                class="text-iron-400 print:text-iron-800 text-sm md:mb-0 print:mb-0"
            >
                Bilingual in Spanish and English. <a
                    href={contact.linkedin}
                    target="_blank"
                    class="text-jade print:text-iron-800 swipe-link">Open</a
                > to remote or on-site roles worldwide.
            </p>
            <p class="text-iron-400 text-sm md:hidden print:hidden">
                Focused on fluid and highly interactive web experiences.
                Currently exploring 3D on the web with WebGL, shaders, Three.js,
                and Theatre.js.
            </p>
        </div>
    </div>

    <Divider fade="end" data-aos-child="fade-in-blur-out" />

    <!-- Contact -->
    <div class="ResumeSection grid gap-1" data-aos-child>
        <h3 class="ResumeHeading subtitle mb-0 text-xs">Contact</h3>
        <ul class="text-iron-300 print:text-iron-800 grid gap-1 text-sm">
            <li>
                <a href={`mailto:${contact.email}`} class="swipe-link">
                    {contact.email}
                </a>
            </li>
            <li>
                <a href={contact.linkedin} target="_blank" class="swipe-link">
                    <span class="print:hidden">
                        {contact.linkedin.replace("https://", "")}
                    </span>
                    <span class="hidden print:inline">
                        {contact.linkedin}
                    </span>
                </a>
            </li>
        </ul>
    </div>

    <Divider fade="end" data-aos-child="fade-in-blur-out" />

    <!-- Skills -->
    <div class="ResumeSection grid gap-1" data-aos-child>
        <h3 class="ResumeHeading subtitle mb-0 text-xs">Skills</h3>
        <div class="grid gap-3">
            {
                skills.map((group) => (
                    <div class="grid">
                        <span class="text-iron-600 text-xs">
                            {group.category}
                        </span>
                        <span class="text-iron-300 print:text-iron-800 text-sm">
                            {group.items.join(" · ")}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>
</aside>
