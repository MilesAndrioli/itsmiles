---
import Divider from "../components/Divider.astro";
import photo from "../assets/images/Miles_0.jpeg";

interface Props {
    meta: any;
    skills: any[];
    languages: any[];
    interests: string[];
}

const { meta, skills, languages, interests } = Astro.props;
---

<aside class="ResumeSidebar grid content-start gap-6 p-8">
    <!-- Photo -->
    <img
        src={photo.src}
        alt={meta.name}
        class="border-iron-800 aspect-square rounded-xl border object-cover filter-[grayscale(100%)_sepia(30%)_contrast(130%)_opacity(80%)]!"
        data-aos-child
    />

    <!-- Contact -->
    <div class="ResumeSection" data-aos-child>
        <h2
            class="ResumeHeading font-display text-xs font-light tracking-widest uppercase"
        >
            Contact
        </h2>
        <ul class="text-iron-300 grid gap-1.5 text-sm">
            <li>
                <a href={`mailto:${meta.email}`} class="swipe-link">
                    {meta.email}
                </a>
            </li>
            <li>
                <a
                    href={`tel:${meta.phone.replace(/\s/g, "")}`}
                    class="swipe-link"
                >
                    {meta.phone}
                </a>
            </li>
            <li>
                <a href={meta.linkedin} target="_blank" class="swipe-link">
                    {
                        meta.linkedin
                            .replace("https://www.", "")
                            .replace(/\/$/, "")
                    }
                </a>
            </li>
        </ul>
    </div>

    <Divider data-aos-child="fade-in" />

    <!-- Skills -->
    <div class="ResumeSection" data-aos-child>
        <h2
            class="ResumeHeading font-display text-xs font-light tracking-widest uppercase"
        >
            Skills
        </h2>
        <div class="grid gap-4">
            {
                skills.map((group: any) => (
                    <div>
                        <p class="text-iron-700 mb-0 font-mono text-xs">
                            {group.category}
                        </p>
                        <p class="text-iron-300 text-sm leading-relaxed">
                            {group.items.join(" · ")}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>

    <Divider data-aos-child="fade-in" />

    <!-- Languages -->
    <div class="ResumeSection" data-aos-child>
        <h2
            class="ResumeHeading font-display text-xs font-light tracking-widest uppercase"
        >
            Languages
        </h2>
        <ul class="grid gap-1 text-sm">
            {
                languages.map((lang: any) => (
                    <li>
                        <span class="text-iron-300">{lang.name}</span>
                        <span class="text-iron-700">&ndash;</span>
                        <span class="text-iron-600">{lang.level}</span>
                    </li>
                ))
            }
        </ul>
    </div>

    <Divider data-aos-child="fade-in" />

    <!-- Interests -->
    <div class="ResumeSection" data-aos-child>
        <h2
            class="ResumeHeading font-display text-xs font-light tracking-widest uppercase"
        >
            Interests
        </h2>
        <ul class="grid gap-1 text-sm">
            {
                interests.map((interest: string) => (
                    <li class="text-iron-300">{interest}</li>
                ))
            }
        </ul>
    </div>
</aside>
