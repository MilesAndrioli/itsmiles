---
import Divider from "@/components/Divider.astro";

const colors = [
    { label: "Iron 400", class: "bg-iron-400", value: "oklch(82% 0.006 70)" },
    { label: "Iron", class: "bg-iron", value: "oklch(70% 0.005 70)" },
    { label: "Iron 950", class: "bg-iron-950", value: "oklch(13% 0.001 70)" },
    { label: "Jade", class: "bg-jade", value: "oklch(87.2% 0.2518 148.1)" },
    { label: "Ruby", class: "bg-ruby", value: "oklch(0.6 0.22 26.93)" },
];
---

<section class="hero-fixed -mt-40">
    <div class="contained">
        <div data-aos-group="fade-in-up">
            <div class="grid gap-6">
                <div class="grid gap-2" data-aos-child>
                    <p
                        class="font-display mb-0 text-sm font-light tracking-wider uppercase"
                    >
                        Colors
                    </p>
                    <p class="text-iron-700 font-mono text-xs">
                        <span class="text-jade">{colors.length}</span> active tokens
                    </p>
                </div>

                <Divider data-aos-child="scale-x" />

                <div
                    class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-6"
                >
                    {
                        colors.map((color) => (
                            <div
                                class="ColorSwatch grid cursor-pointer gap-3"
                                data-aos-child
                                data-cursor-text="Copy"
                                data-value={color.value}
                            >
                                <div
                                    class:list={[
                                        color.class,
                                        "border-iron-850 aspect-4/3 rounded-xl border",
                                    ]}
                                />
                                <div>
                                    <p class="mb-0 text-xs">{color.label}</p>
                                    <p class="text-iron-700 font-mono text-xs">
                                        {color.value}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.querySelectorAll<HTMLElement>(".ColorSwatch").forEach((swatch) => {
        swatch.addEventListener("click", () => {
            const value = swatch.dataset.value;
            if (!value) return;

            navigator.clipboard.writeText(value);

            swatch.dataset.cursorText = "Copied!";
            swatch.dispatchEvent(
                new MouseEvent("mouseover", { bubbles: true }),
            );
            swatch.dataset.cursorText = "Copy";
        });
    });
</script>
