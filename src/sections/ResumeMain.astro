---
import Divider from "@/components/Divider.astro";

const { name, title, experience, projects } = Astro.props;
---

<div class="ResumeMain grid content-start gap-5 p-8 pt-0 md:pt-8">
    <!-- Name & Title (desktop) -->
    <div class="hidden gap-1 md:grid">
        <h1
            class="ResumeName text-iron-50 mb-0 font-serif text-4xl"
            data-aos-child="split-chromatic"
        >
            {name}
        </h1>
        <h2 class="subtitle" data-aos-child="split-chromatic">
            {title}
        </h2>
    </div>

    <Divider fade="end" data-aos-child="fade-in-blur-out" />

    <!-- Experience -->
    <div class="ResumeSection grid gap-1" data-aos-child>
        <h3 class="ResumeHeading subtitle mb-0 text-xs">Experience</h3>
        <div class="grid gap-5">
            {
                experience.map((job) => (
                    <div class="ResumeJob grid gap-3">
                        <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-iron-200 text-sm font-bold">
                                    {job.role}
                                </span>
                                <a
                                    href={job.website}
                                    target="_blank"
                                    class="yoyo-link text-jade text-xs"
                                >
                                    {job.website.replace("https://", "")}
                                </a>
                            </div>
                            <span class="text-iron-600 text-xs">
                                {job.duration}
                            </span>
                        </div>
                        <p class="mb-0 text-sm">{job.description}</p>
                        {job.highlights && job.highlights.length > 0 && (
                            <ul class="marker:text-iron-700 text-iron-400 grid list-disc gap-1 ps-4 text-sm">
                                {job.highlights.map((h) => (
                                    <li>{h}</li>
                                ))}
                            </ul>
                        )}
                    </div>
                ))
            }
        </div>
    </div>

    <Divider fade="end" data-aos-child="fade-in-blur-out" />

    <!-- Projects -->
    <div class="ResumeSection grid gap-1" data-aos-child>
        <h3 class="ResumeHeading subtitle mb-0 text-xs">Projects</h3>
        <div class="grid gap-5">
            {
                projects.map((project) => (
                    <div class="ResumeProject grid gap-3">
                        <div class="grid gap-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-iron-200 text-sm font-bold">
                                    {project.name}
                                </span>
                                <a
                                    href={project.url}
                                    target="_blank"
                                    class="yoyo-link text-jade text-xs"
                                >
                                    {project.url.replace("https://", "")}
                                </a>
                            </div>
                            {project.stack && project.stack.length > 0 && (
                                <span class="text-iron-600 text-xs">
                                    {project.stack.join(" · ")}
                                </span>
                            )}
                        </div>
                        <p class="mb-0 text-sm">{project.description}</p>
                        {project.highlights &&
                            project.highlights.length > 0 && (
                                <ul class="marker:text-iron-700 text-iron-400 grid list-disc gap-1 ps-4 text-sm">
                                    {project.highlights.map((h) => (
                                        <li>{h}</li>
                                    ))}
                                </ul>
                            )}
                    </div>
                ))
            }
        </div>
    </div>
</div>
