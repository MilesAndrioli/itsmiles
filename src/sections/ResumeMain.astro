---
import Divider from "@/components/Divider.astro";

const { name, title, summary, experience, projects } = Astro.props;
---

<div class="ResumeMain grid content-start gap-5 p-8">
    <!-- Name & Title (desktop only) -->
    <div class="hidden gap-2 md:grid" data-aos-child>
        <h1 class="ResumeName text-iron-50 mb-0 font-serif text-4xl">
            {name}
        </h1>
        <p class="font-display font-light tracking-wider uppercase">
            {title}
        </p>
    </div>

    <Divider fade="end" data-aos-child="fade-in" />

    <!-- Summary -->
    <div class="ResumeSection grid gap-3" data-aos-child>
        <h2
            class="ResumeHeading font-display mb-0 text-xs font-light tracking-widest uppercase"
        >
            Summary
        </h2>
        <p class="text-iron-300 leading-relaxed">
            {summary}
        </p>
    </div>

    <Divider fade="end" data-aos-child="fade-in" />

    <!-- Experience -->
    <div class="ResumeSection grid gap-3" data-aos-child>
        <h2
            class="ResumeHeading font-display mb-0 text-xs font-light tracking-widest uppercase"
        >
            Experience
        </h2>
        <div class="grid gap-6">
            {
                experience.map((job) => (
                    <div class="ResumeJob grid gap-2">
                        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                            <h3 class="text-iron-200 text-base font-bold">
                                {job.role}
                            </h3>
                            <span class="text-iron-600 text-xs">
                                {job.duration}
                            </span>
                        </div>
                        <p class="text-iron-500 text-sm">
                            <span class="text-iron-700"> • </span>
                            {job.location}
                        </p>
                        <ul class="marker:text-iron-700 grid list-disc gap-1 ps-4">
                            {job.highlights.map((h) => (
                                <li class="text-iron-400 text-sm">{h}</li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>

    <Divider fade="end" data-aos-child="fade-in" />

    <!-- Projects -->
    <div class="ResumeSection grid gap-3" data-aos-child>
        <h2
            class="ResumeHeading font-display mb-0 text-xs font-light tracking-widest uppercase"
        >
            Projects
        </h2>
        <div class="grid gap-4">
            {
                projects.map((project) => (
                    <div class="grid gap-1">
                        <div class="flex items-baseline gap-2">
                            <h3 class="text-iron-200 text-sm font-bold">
                                {project.name}
                            </h3>
                            <a
                                href={project.url}
                                target="_blank"
                                class="yoyo-link text-jade text-xs"
                            >
                                {project.url.replace("https://", "")}
                            </a>
                        </div>
                        <p class="text-iron-400 text-sm">
                            {project.description}
                        </p>
                        {project.stack && project.stack.length > 0 && (
                            <p class="text-iron-600 text-xs">
                                {project.stack.map((s, i) => (
                                    <>
                                        {i > 0 && (
                                            <span class="text-iron-700">
                                                {" "}
                                                •{" "}
                                            </span>
                                        )}
                                        {s}
                                    </>
                                ))}
                            </p>
                        )}
                        {project.highlights &&
                            project.highlights.length > 0 && (
                                <ul class="marker:text-iron-700 grid list-disc gap-1 ps-4">
                                    {project.highlights.map((h) => (
                                        <li class="text-iron-400 text-sm">
                                            {h}
                                        </li>
                                    ))}
                                </ul>
                            )}
                    </div>
                ))
            }
        </div>
    </div>
</div>
