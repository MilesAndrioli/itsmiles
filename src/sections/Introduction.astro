---
import AsciiVideo from "@/components/AsciiVideo.astro";
---

<section class="heroF">
    <div class="contained">
        <div
            data-aos-group="split-up-blur"
            data-aos-duration="1200"
            data-aos-stagger-gap="220"
            data-aos-delay="100"
        >
            <div class="grid gap-10 md:grid-cols-12 md:gap-20">
                <h1
                    class="text-iron-300 col-span-full m-0 font-serif text-6xl md:text-7xl"
                    data-aos-child="split-left-blur"
                >
                    Hey, it's Miles.
                </h1>

                <div
                    class="order-first md:order-0 md:col-span-4 md:col-start-3 md:h-0"
                    data-aos-child="fade-in-blur-out"
                >
                    <AsciiVideo
                        src="/Choom.mp4"
                        class="overflow-hidden rounded-4xl"
                        mediaClass="aspect-4/5 w-full object-cover object-center"
                        data-ascii-width="80"
                        data-ascii-color="var(--color-ruby)"
                        data-ascii-charset="minimal"
                        data-ascii-contrast="160"
                        data-ascii-lh="1"
                    />
                </div>

                <div class="col-span-full md:col-start-7">
                    <h2 class="text-iron-400 text-xl" data-aos-child>
                        Focused on fluid and interactive web experiences.
                        Currently exploring 3D on the web with WebGL, GLSL,
                        Three.js, and Theatre.js.
                    </h2>
                    <p class="text-xl" data-aos-child>
                        This is still a work in progress. In the meantime, check
                        out my
                        <a
                            href="/resume/"
                            class="swipe-link text-jade"
                            data-hover-shuffle
                        >
                            resume
                        </a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
